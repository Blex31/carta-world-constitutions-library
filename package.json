{
  "name": "carta-world-constitutions-library",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "import:constitutions": "node scripts/import-constitution-documents.mjs",
    "test": "node --test",
    "audit:coverage": "node scripts/audit-coverage.mjs",
    "syntaxcheck": "node --check src/auth.js && node --check scripts/audit-coverage.mjs && node --check scripts/import-constitution-documents.mjs",
    "audit:coverage:database": "node scripts/audit-coverage.mjs --require-database"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "@vitejs/plugin-react": "6.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "pg": "^8.16.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
